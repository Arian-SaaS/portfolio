# Resend (https://resend.com) — required for the /contact form to send email.
# Without it the API returns 503 and the form shows a "not configured" notice.
RESEND_API_KEY=

# Destination inbox for contact form submissions. Defaults to the email in data/site-config.ts.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in your Resend dashboard
# (Domains -> Add Domain, then add the DNS records it gives you).
#
# Leave blank and it falls back to Resend's shared sandbox sender,
# onboarding@resend.dev, which needs no setup but will ONLY deliver to the
# address that owns the Resend account, and lands in spam elsewhere. Fine for
# testing, not for real inquiries.
#
#   CONTACT_FROM_EMAIL=contact@yourdomain.com
CONTACT_FROM_EMAIL=
